{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voxify",
  "version": "1.0.7",
  "identifier": "com.voxify.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voxify",
        "width": 860,
        "height": 620,
        "minWidth": 860,
        "minHeight": 620,
        "maxWidth": 860,
        "maxHeight": 620,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "models/kokoro-en-v0_19/**/*",
      "resources/redist/**/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
